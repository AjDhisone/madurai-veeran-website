{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install npm dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false
		},
		{
			"label": "Start Next dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"options": {
				"cwd": "${workspaceFolder}"
			}
		}
	]
}